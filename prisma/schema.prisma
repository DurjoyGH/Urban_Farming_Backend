generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  status    String
  createdAt DateTime @default(now())

  vendorProfile VendorProfile?

  orders        Order[]
  posts         CommunityPost[] 
}

model VendorProfile {
  id                  Int    @id @default(autoincrement())
  userId              Int    @unique
  farmName            String
  certificationStatus CertificationStatus
  farmLocation        String

  user    User     @relation(fields: [userId], references: [id])

  produce        Produce[]
  orders         Order[]
  rentalSpaces   RentalSpace[]
  certifications SustainabilityCert[] 
}

model Produce {
  id                  Int    @id @default(autoincrement())
  vendorId            Int
  name                String
  description         String
  price               Float
  category            String
  certificationStatus CertificationStatus
  availableQuantity   Int

  vendor VendorProfile @relation(fields: [vendorId], references: [id])
}

model Order {
  id        Int      @id @default(autoincrement())
  userId    Int
  produceId Int
  vendorId  Int
  status    String
  orderDate DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  vendor VendorProfile  @relation(fields: [vendorId], references: [id])
}

model RentalSpace {
  id          Int     @id @default(autoincrement())
  vendorId    Int
  location    String
  size        String
  price       Float
  availability Boolean

  vendor VendorProfile @relation(fields: [vendorId], references: [id])
}

model CommunityPost {
  id          Int      @id @default(autoincrement())
  userId      Int
  postContent String
  postDate    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SustainabilityCert {
  id                Int      @id @default(autoincrement())
  vendorId          Int
  certifyingAgency  String
  certificationDate DateTime

  vendor VendorProfile @relation(fields: [vendorId], references: [id])
}

enum Role {
  ADMIN
  VENDOR
  CUSTOMER
}

enum CertificationStatus {
  PENDING
  APPROVED
  REJECTED
}