generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  status    String
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  VENDOR
  CUSTOMER
}
